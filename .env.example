# ─────────────────────────────────────────────────────────────────────────────
# NEVER put secrets in this file (or in .env).
# .env is bundled into the app as an asset, so anything here ships inside the
# APK / IPA and can be extracted by anyone. Only public values belong here:
# the Supabase anon key is safe because every table is protected by RLS.
# Server-side secrets (GitHub client secret, Supabase service role key, admin
# secrets) live in the backend's environment only.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Supabase Configuration ──────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# ─── GitHub OAuth App (public client id only) ────────────────────────────────
GITHUB_CLIENT_ID=your_github_oauth_app_client_id

# ─── Python Backend URL ─────────────────────────────────────────────────────
# Production (default): https://gitalong-backend.onrender.com
# Local Android emulator: http://10.0.2.2:8000
# Local physical device:  http://YOUR_MACHINE_IP:8000
BACKEND_URL=https://gitalong-backend.onrender.com

# ─── App Configuration ──────────────────────────────────────────────────────
APP_NAME=GitAlong
APP_VERSION=1.1.0
DEBUG_MODE=false
