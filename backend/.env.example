# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Settings → API → service_role. Server-side only; never ship to clients.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Only for projects still on the legacy HS256 JWT secret (Settings → API → JWT secret).
# Projects using asymmetric signing keys are verified via JWKS and can leave this empty.
SUPABASE_JWT_SECRET=

# ─── GitHub API ──────────────────────────────────────────────────────────────
# Optional but recommended: raises the GitHub rate limit from 60 to 5000 req/hour.
GITHUB_TOKEN=

# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME=GitAlong API
DEBUG=false
# Browser origins allowed to call the API (the website). Mobile apps are unaffected.
ALLOWED_ORIGINS=https://gitalong.app,https://www.gitalong.app,https://gitalong.vercel.app,http://localhost:5173
RATE_LIMIT_PER_MINUTE=120

# ─── Recommendations ─────────────────────────────────────────────────────────
RECOMMENDATION_LIMIT=20
CANDIDATE_POOL_SIZE=200
# Re-rank with the trained logistic-regression model (falls back safely if untrained).
ML_RANKING_ENABLED=false
ML_MODEL_NAME=logreg_v1

# ─── Admin / Ops ─────────────────────────────────────────────────────────────
# Required for POST /api/v1/admin/retrain-ml and GET /api/v1/admin/metrics. Use a long random value.
ADMIN_RETRAIN_SECRET=
